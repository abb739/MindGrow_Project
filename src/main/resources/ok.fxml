<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="rootPane" style="-fx-background-color: linear-gradient(to bottom right, #e6e9f0, #eef1f5);"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ActivityController">

    <!-- HEADER -->
    <top>
        <HBox alignment="CENTER" spacing="20" style="-fx-background-color:#b1eab6; -fx-padding:20;">
            <Button fx:id="btnBackToSession" text="⬅ Séance" onAction="#goToSession"
                    style="-fx-background-color:#acd88e; -fx-text-fill:#5e9f32; -fx-font-weight:bold; -fx-background-radius:20;"/>
            <Label text="Gestion des Activités" style="-fx-text-fill:white; -fx-font-size:22px; -fx-font-weight:bold;"/>

        </HBox>
    </top>

    <!-- MAIN -->
    <center>
        <VBox spacing="25">
            <padding><Insets top="25" right="30" bottom="25" left="30"/></padding>

            <!-- FORM -->
            <GridPane hgap="15" vgap="15" style="-fx-background-color:white; -fx-padding:25; -fx-background-radius:15; -fx-effect:dropshadow(gaussian, rgba(142,124,195,0.3),15,0,0,5);">
                <Label text="Type:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <ComboBox fx:id="comboType" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label text="Description:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                <TextField fx:id="txtDescription" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
                <Label text="Durée (min):" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="txtDuree" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                <Label text="Heure début:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                <Spinner fx:id="txtStartTime" GridPane.rowIndex="1" GridPane.columnIndex="3"/>
                <Label text="Session ID:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <ComboBox fx:id="comboSession" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <!-- Buttons -->
                <HBox alignment="CENTER" spacing="20" GridPane.rowIndex="3" GridPane.columnIndex="0" GridPane.columnSpan="4">
                    <Button fx:id="btnAdd" onAction="#Add" text="Ajouter" style="-fx-background-color:#6fa8dc; -fx-text-fill:white; -fx-background-radius:20; -fx-font-weight:bold;"/>
                    <Button fx:id="btnUpdate" onAction="#Update" text="Modifier" style="-fx-background-color:#8e7cc3; -fx-text-fill:white; -fx-background-radius:20; -fx-font-weight:bold;"/>
                    <Button fx:id="btnDelete" onAction="#Delete" text="Supprimer" style="-fx-background-color:#e06666; -fx-text-fill:white; -fx-background-radius:20; -fx-font-weight:bold;"/>
                </HBox>
            </GridPane>

            <!-- TABLE -->
            <VBox spacing="10" style="-fx-background-color:white; -fx-padding:25; -fx-background-radius:15; -fx-effect:dropshadow(gaussian, rgba(111,168,220,0.3),15,0,0,5);">
                <Label text="📅 Liste des Activités" style="-fx-font-size:18px; -fx-font-weight:bold; -fx-text-fill:#6a5acd;"/>
                <TableView fx:id="tableActivity" prefHeight="337" prefWidth="611" style="-fx-background-radius:10;">
                    <columns>
                        <TableColumn fx:id="IDColmn" text="ID" prefWidth="60"/>
                        <TableColumn fx:id="typeColmn" text="Type" prefWidth="120"/>
                        <TableColumn fx:id="descColmn" text="Description" prefWidth="180"/>
                        <TableColumn fx:id="dureeColmn" text="Durée" prefWidth="80"/>
                        <TableColumn fx:id="startTimeColmn" text="Heure début" prefWidth="100"/>
                        <TableColumn fx:id="sessionColmn" text="Session" prefWidth="80"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>
