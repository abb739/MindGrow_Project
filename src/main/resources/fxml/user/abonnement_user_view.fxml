<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.user.AbonnementUserController"
            style="-fx-background-color: #F5F5F5;">

    <!-- En-tête -->
    <top>
        <VBox style="-fx-background-color: linear-gradient(to right, #7CAA85, #A2D5AB); -fx-padding: 30;">
            <HBox alignment="CENTER_LEFT" spacing="15">
                <VBox alignment="CENTER" style="-fx-background-color: white; -fx-background-radius: 50; -fx-padding: 15; -fx-pref-width: 60; -fx-pref-height: 60;">
                    <Label text="👤" style="-fx-font-size: 30;"/>
                </VBox>
                <VBox>
                    <Label fx:id="bienvenuLabel" text="Bienvenue" textFill="WHITE">
                        <font><Font name="System Bold" size="28.0"/></font>
                    </Label>
                    <Label text="Gérez votre abonnement MindGrow" textFill="WHITE" style="-fx-padding: 5 0 0 0; -fx-opacity: 0.9;">
                        <font><Font size="14.0"/></font>
                    </Label>
                </VBox>
            </HBox>
        </VBox>
    </top>

    <!-- Contenu -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox spacing="25" style="-fx-padding: 30;">

                <!-- Mon abonnement actuel -->
                <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(162, 213, 171, 0.3), 15, 0, 0, 3);">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="💳" style="-fx-font-size: 24;"/>
                        <Label text="Mon abonnement actuel" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #4A4A4A;"/>
                    </HBox>

                    <Separator style="-fx-background-color: #A2D5AB; -fx-pref-height: 2;"/>

                    <GridPane hgap="30" vgap="15" style="-fx-padding: 10 0 0 0;">
                        <columnConstraints>
                            <ColumnConstraints minWidth="150" prefWidth="150"/>
                            <ColumnConstraints minWidth="250" prefWidth="250"/>
                        </columnConstraints>

                        <Label text="Type d'abonnement:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #4A4A4A;"/>
                        <Label fx:id="typeActuelLabel" text="AUCUN" GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-font-size: 16; -fx-text-fill: #7CAA85; -fx-font-weight: bold;"/>

                        <Label text="Montant:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold; -fx-text-fill: #4A4A4A;"/>
                        <Label fx:id="montantActuelLabel" text="0.00 €" GridPane.columnIndex="1" GridPane.rowIndex="1" style="-fx-font-size: 16;"/>

                        <Label text="Date d'expiration:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold; -fx-text-fill: #4A4A4A;"/>
                        <Label fx:id="dateExpirationLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="2" style="-fx-font-size: 16;"/>

                        <Label text="Statut:" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-font-weight: bold; -fx-text-fill: #4A4A4A;"/>
                        <Label fx:id="statutLabel" text="INACTIF" GridPane.columnIndex="1" GridPane.rowIndex="3" style="-fx-font-size: 16;"/>
                    </GridPane>

                    <HBox spacing="15" style="-fx-padding: 15 0 0 0;">
                        <Button fx:id="btnAnnuler" text="❌ Annuler mon abonnement" onAction="#annulerAbonnement"
                                style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 25; -fx-background-radius: 8; -fx-cursor: hand;"/>
                    </HBox>
                </VBox>

                <!-- Choisir un forfait -->
                <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(162, 213, 171, 0.3), 15, 0, 0, 3);">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="🎯" style="-fx-font-size: 24;"/>
                        <Label text="Choisir ou modifier mon forfait" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #4A4A4A;"/>
                    </HBox>

                    <Separator style="-fx-background-color: #A2D5AB; -fx-pref-height: 2;"/>

                    <!-- Message informatif -->
                    <HBox alignment="CENTER" spacing="10" style="-fx-background-color: #E3F2FD; -fx-padding: 12; -fx-background-radius: 8; -fx-border-color: #2196F3; -fx-border-width: 1; -fx-border-radius: 8;">
                        <Label text="ℹ️" style="-fx-font-size: 16;"/>
                        <Label text="La durée de votre abonnement sera calculée automatiquement selon le forfait choisi"
                               style="-fx-font-size: 12; -fx-text-fill: #424242; -fx-wrap-text: true;"/>
                    </HBox>

                    <!-- Cartes de forfaits -->
                    <HBox spacing="20" alignment="CENTER" style="-fx-padding: 20 0 0 0;">

                        <!-- Forfait MENSUEL -->
                        <VBox spacing="15" alignment="CENTER"
                              style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 12; -fx-border-color: #27ae60; -fx-border-width: 3; -fx-border-radius: 12; -fx-pref-width: 250; -fx-effect: dropshadow(gaussian, rgba(39, 174, 96, 0.3), 10, 0, 0, 2);">
                            <Label text="MENSUEL" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #4A4A4A;"/>
                            <Label text="9.99 €" style="-fx-font-size: 36; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                            <Label text="/ mois" style="-fx-font-size: 14; -fx-text-fill: #95a5a6;"/>
                            <Separator prefWidth="150" style="-fx-background-color: #E8E8E8;"/>
                            <VBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 10 0;">
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Label text="✓" style="-fx-text-fill: #27ae60; -fx-font-weight: bold; -fx-font-size: 16;"/>
                                    <Label text="Accès illimité" style="-fx-text-fill: #4A4A4A; -fx-font-weight: bold;"/>
                                </HBox>
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Label text="✓" style="-fx-text-fill: #27ae60; -fx-font-weight: bold; -fx-font-size: 16;"/>
                                    <Label text="Tous les ateliers" style="-fx-text-fill: #4A4A4A;"/>
                                </HBox>
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Label text="✓" style="-fx-text-fill: #27ae60; -fx-font-weight: bold; -fx-font-size: 16;"/>
                                    <Label text="Support standard" style="-fx-text-fill: #4A4A4A;"/>
                                </HBox>
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Label text="📅" style="-fx-font-size: 14;"/>
                                    <Label text="Durée: 1 mois" style="-fx-text-fill: #7f8c8d; -fx-font-style: italic; -fx-font-size: 12;"/>
                                </HBox>
                            </VBox>
                            <Button fx:id="btnChoisirMensuel" text="Choisir ce forfait" onAction="#choisirForfaitMensuel"
                                    style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 14 30; -fx-background-radius: 8; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(39, 174, 96, 0.4), 8, 0, 0, 2);"/>
                        </VBox>

                        <!-- Forfait TRIMESTRIEL -->
                        <VBox spacing="15" alignment="CENTER"
                              style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 12; -fx-border-color: #f39c12; -fx-border-width: 3; -fx-border-radius: 12; -fx-pref-width: 250; -fx-effect: dropshadow(gaussian, rgba(243, 156, 18, 0.3), 10, 0, 0, 2);">
                            <Label text="⭐ POPULAIRE" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: white; -fx-background-color: #f39c12; -fx-padding: 6 15; -fx-background-radius: 12;"/>
                            <Label text="TRIMESTRIEL" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #4A4A4A;"/>
                            <Label text="24.99 €" style="-fx-font-size: 36; -fx-font-weight: bold; -fx-text-fill: #f39c12;"/>
                            <Label text="/ 3 mois (-16%)" style="-fx-font-size: 14; -fx-text-fill: #27ae60; -fx-font-weight: bold;"/>
                            <Separator prefWidth="150" style="-fx-background-color: #E8E8E8;"/>
                            <VBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 10 0;">
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Label text="✓" style="-fx-text-fill: #f39c12; -fx-font-weight: bold; -fx-font-size: 16;"/>
                                    <Label text="Accès illimité" style="-fx-text-fill: #4A4A4A; -fx-font-weight: bold;"/>
                                </HBox>
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Label text="✓" style="-fx-text-fill: #f39c12; -fx-font-weight: bold; -fx-font-size: 16;"/>
                                    <Label text="Tous les ateliers" style="-fx-text-fill: #4A4A4A;"/>
                                </HBox>
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Label text="✓" style="-fx-text-fill: #f39c12; -fx-font-weight: bold; -fx-font-size: 16;"/>
                                    <Label text="Coach personnel" style="-fx-text-fill: #4A4A4A;"/>
                                </HBox>
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Label text="📅" style="-fx-font-size: 14;"/>
                                    <Label text="Durée: 3 mois" style="-fx-text-fill: #7f8c8d; -fx-font-style: italic; -fx-font-size: 12;"/>
                                </HBox>
                            </VBox>
                            <Button fx:id="btnChoisirTrimestriel" text="Choisir ce forfait" onAction="#choisirForfaitTrimestriel"
                                    style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 14 30; -fx-background-radius: 8; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(243, 156, 18, 0.4), 8, 0, 0, 2);"/>
                        </VBox>

                        <!-- Forfait ANNUEL -->
                        <VBox spacing="15" alignment="CENTER"
                              style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 12; -fx-border-color: #3498db; -fx-border-width: 3; -fx-border-radius: 12; -fx-pref-width: 250; -fx-effect: dropshadow(gaussian, rgba(52, 152, 219, 0.3), 10, 0, 0, 2);">
                            <Label text="💎 MEILLEURE OFFRE" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: white; -fx-background-color: #3498db; -fx-padding: 6 12; -fx-background-radius: 12;"/>
                            <Label text="ANNUEL" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #4A4A4A;"/>
                            <Label text="89.99 €" style="-fx-font-size: 36; -fx-font-weight: bold; -fx-text-fill: #3498db;"/>
                            <Label text="/ an (-25%)" style="-fx-font-size: 14; -fx-text-fill: #27ae60; -fx-font-weight: bold;"/>
                            <Separator prefWidth="150" style="-fx-background-color: #E8E8E8;"/>
                            <VBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 10 0;">
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Label text="✓" style="-fx-text-fill: #3498db; -fx-font-weight: bold; -fx-font-size: 16;"/>
                                    <Label text="Tout inclus" style="-fx-text-fill: #4A4A4A; -fx-font-weight: bold;"/>
                                </HBox>
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Label text="✓" style="-fx-text-fill: #3498db; -fx-font-weight: bold; -fx-font-size: 16;"/>
                                    <Label text="Priorité réservation" style="-fx-text-fill: #4A4A4A;"/>
                                </HBox>
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Label text="✓" style="-fx-text-fill: #3498db; -fx-font-weight: bold; -fx-font-size: 16;"/>
                                    <Label text="Ateliers exclusifs" style="-fx-text-fill: #4A4A4A;"/>
                                </HBox>
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Label text="📅" style="-fx-font-size: 14;"/>
                                    <Label text="Durée: 12 mois" style="-fx-text-fill: #7f8c8d; -fx-font-style: italic; -fx-font-size: 12;"/>
                                </HBox>
                            </VBox>
                            <Button fx:id="btnChoisirAnnuel" text="Choisir ce forfait" onAction="#choisirForfaitAnnuel"
                                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 14 30; -fx-background-radius: 8; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(52, 152, 219, 0.4), 8, 0, 0, 2);"/>
                        </VBox>

                    </HBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

    <!-- Pied de page -->
    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: linear-gradient(to right, #7CAA85, #A2D5AB); -fx-padding: 15;">
            <Label text="MindGrow - Votre bien-être, notre priorité 🌱" textFill="WHITE" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
        </HBox>
    </bottom>

</BorderPane>
