<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.user.PaiementUserController"
            style="-fx-background-color: #F5F5F5;">

    <!-- En-tête -->
    <top>
        <VBox style="-fx-background-color: linear-gradient(to right, #7CAA85, #A2D5AB); -fx-padding: 30;">
            <HBox alignment="CENTER_LEFT" spacing="15">
                <VBox alignment="CENTER" style="-fx-background-color: white; -fx-background-radius: 50; -fx-padding: 15; -fx-pref-width: 60; -fx-pref-height: 60;">
                    <Label text="💳" style="-fx-font-size: 30;"/>
                </VBox>
                <VBox>
                    <Label fx:id="bienvenuLabel" text="Paiement sécurisé" textFill="WHITE">
                        <font><Font name="System Bold" size="28.0"/></font>
                    </Label>
                    <Label text="Finalisez votre abonnement MindGrow" textFill="WHITE" style="-fx-padding: 5 0 0 0; -fx-opacity: 0.9;">
                        <font><Font size="14.0"/></font>
                    </Label>
                </VBox>
            </HBox>
        </VBox>
    </top>

    <!-- Contenu -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox spacing="25" style="-fx-padding: 30;">

                <!-- Abonnement sélectionné -->
                <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(162, 213, 171, 0.3), 15, 0, 0, 3);">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="📦" style="-fx-font-size: 24;"/>
                        <Label text="Récapitulatif de votre commande" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #4A4A4A;"/>
                    </HBox>

                    <Separator style="-fx-background-color: #A2D5AB; -fx-pref-height: 2;"/>

                    <GridPane hgap="30" vgap="15" style="-fx-padding: 10 0 0 0;">
                        <columnConstraints>
                            <ColumnConstraints minWidth="180" prefWidth="180"/>
                            <ColumnConstraints minWidth="250" prefWidth="250"/>
                        </columnConstraints>

                        <Label text="Type d'abonnement:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #4A4A4A;"/>
                        <Label fx:id="selectedTypeLabel" text="AUCUN" GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-font-size: 18; -fx-text-fill: #7CAA85; -fx-font-weight: bold;"/>

                        <Label text="Montant à payer:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold; -fx-text-fill: #4A4A4A;"/>
                        <Label fx:id="selectedMontantLabel" text="0.00 €" GridPane.columnIndex="1" GridPane.rowIndex="1" style="-fx-font-size: 22; -fx-text-fill: #27ae60; -fx-font-weight: bold;"/>
                    </GridPane>
                </VBox>

                <!-- Formulaire de paiement -->
                <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(162, 213, 171, 0.3), 15, 0, 0, 3);">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="💳" style="-fx-font-size: 24;"/>
                        <Label text="Informations de paiement" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #4A4A4A;"/>
                    </HBox>

                    <Separator style="-fx-background-color: #A2D5AB; -fx-pref-height: 2;"/>

                    <GridPane hgap="20" vgap="15" style="-fx-padding: 10 0 0 0;">
                        <columnConstraints>
                            <ColumnConstraints minWidth="180" prefWidth="180"/>
                            <ColumnConstraints minWidth="400" prefWidth="400"/>
                        </columnConstraints>

                        <!-- Mode de paiement -->
                        <Label text="Mode de paiement:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #4A4A4A;"/>
                        <ComboBox fx:id="modePaiementCombo" GridPane.columnIndex="1" GridPane.rowIndex="0"
                                  prefWidth="400"
                                  style="-fx-font-size: 14; -fx-background-radius: 8; -fx-border-radius: 8;"/>

                        <!-- Numéro de carte -->
                        <Label text="Numéro de carte:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold; -fx-text-fill: #4A4A4A;"/>
                        <TextField fx:id="numeroCarteField" GridPane.columnIndex="1" GridPane.rowIndex="1"
                                   promptText="1234 5678 9012 3456"
                                   prefWidth="400"
                                   style="-fx-font-size: 14; -fx-padding: 10; -fx-background-radius: 8; -fx-border-color: #A2D5AB; -fx-border-radius: 8;"/>

                        <!-- Nom sur la carte -->
                        <Label text="Nom sur la carte:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold; -fx-text-fill: #4A4A4A;"/>
                        <TextField fx:id="nomCarteField" GridPane.columnIndex="1" GridPane.rowIndex="2"
                                   promptText="JEAN DUPONT"
                                   prefWidth="400"
                                   style="-fx-font-size: 14; -fx-padding: 10; -fx-background-radius: 8; -fx-border-color: #A2D5AB; -fx-border-radius: 8;"/>

                        <!-- CVV et Expiration -->
                        <Label text="CVV / Date expiration:" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-font-weight: bold; -fx-text-fill: #4A4A4A;"/>
                        <HBox spacing="15" GridPane.columnIndex="1" GridPane.rowIndex="3">
                            <TextField fx:id="cvvField"
                                       promptText="123"
                                       prefWidth="120"
                                       style="-fx-font-size: 14; -fx-padding: 10; -fx-background-radius: 8; -fx-border-color: #A2D5AB; -fx-border-radius: 8;"/>
                            <TextField fx:id="expirationField"
                                       promptText="MM/YY"
                                       prefWidth="120"
                                       style="-fx-font-size: 14; -fx-padding: 10; -fx-background-radius: 8; -fx-border-color: #A2D5AB; -fx-border-radius: 8;"/>
                        </HBox>
                    </GridPane>

                    <!-- Boutons d'action -->
                    <HBox spacing="15" style="-fx-padding: 25 0 0 0;" alignment="CENTER">
                        <Button fx:id="btnRetourAbonnements" text="← Retour aux abonnements" onAction="#retourAbonnements"
                                style="-fx-background-color: white; -fx-border-color: #95a5a6; -fx-border-width: 2; -fx-text-fill: #4A4A4A; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 14 30; -fx-background-radius: 8; -fx-border-radius: 8; -fx-cursor: hand;"/>
                        <Button fx:id="btnValiderPaiement" text="✓ Valider le paiement" onAction="#validerPaiement"
                                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 14 40; -fx-background-radius: 8; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(39, 174, 96, 0.4), 10, 0, 0, 2);"/>
                    </HBox>

                    <!-- Message de sécurité -->
                    <HBox alignment="CENTER" spacing="10" style="-fx-background-color: #E8F5E9; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #4CAF50; -fx-border-width: 1; -fx-border-radius: 8;">
                        <Label text="🔒" style="-fx-font-size: 18;"/>
                        <Label text="Paiement 100% sécurisé. Vos données sont cryptées et protégées."
                               style="-fx-font-size: 13; -fx-text-fill: #2E7D32; -fx-wrap-text: true; -fx-font-weight: bold;"/>
                    </HBox>
                </VBox>

                <!-- Statistiques -->
                <HBox spacing="20" alignment="CENTER">
                    <VBox spacing="10" alignment="CENTER" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-pref-width: 300; -fx-effect: dropshadow(gaussian, rgba(162, 213, 171, 0.3), 10, 0, 0, 2);">
                        <Label text="📊 Mes paiements" style="-fx-font-size: 14; -fx-text-fill: #4A4A4A; -fx-font-weight: bold;"/>
                        <Label fx:id="nombrePaiementsLabel" text="0" style="-fx-font-size: 32; -fx-text-fill: #7CAA85; -fx-font-weight: bold;"/>
                    </VBox>

                    <VBox spacing="10" alignment="CENTER" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-pref-width: 300; -fx-effect: dropshadow(gaussian, rgba(162, 213, 171, 0.3), 10, 0, 0, 2);">
                        <Label text="💰 Total payé" style="-fx-font-size: 14; -fx-text-fill: #4A4A4A; -fx-font-weight: bold;"/>
                        <Label fx:id="totalPayeLabel" text="0.00 €" style="-fx-font-size: 32; -fx-text-fill: #7CAA85; -fx-font-weight: bold;"/>
                    </VBox>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

    <!-- Pied de page -->
    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: linear-gradient(to right, #7CAA85, #A2D5AB); -fx-padding: 15;">
            <Label text="MindGrow - Paiement sécurisé SSL 🔒" textFill="WHITE" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
        </HBox>
    </bottom>

</BorderPane>
