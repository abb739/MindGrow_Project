<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="20.0" style="-fx-background-color: #F9FAFB;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AddTherapeuteController">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>
    <children>
        <Button onAction="#handleCancel" style="-fx-background-color: transparent; -fx-cursor: hand;" text="← Retour à la liste" textFill="#6b7280" />

        <Label fx:id="titleLabel" text="Ajouter un nouvel Expert" textFill="#4A4A4A">
            <font><Font name="System Bold" size="28.0" /></font>
        </Label>

        <GridPane hgap="20.0" vgap="20.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>
                <VBox spacing="5.0">
                    <children>
                        <Label text="Nom *" textFill="#4A4A4A" />
                        <TextField fx:id="nomField" promptText="Ex: Ben Amor" style="-fx-background-radius: 8;" />
                    </children>
                </VBox>
                <VBox spacing="5.0" GridPane.columnIndex="1">
                    <children>
                        <Label text="Prénom *" textFill="#4A4A4A" />
                        <TextField fx:id="prenomField" promptText="Ex: Ayoub" style="-fx-background-radius: 8;" />
                    </children>
                </VBox>
                <VBox spacing="5.0" GridPane.rowIndex="1">
                    <children>
                        <Label text="Email (Gmail recommandé) *" textFill="#4A4A4A" />
                        <TextField fx:id="emailField" promptText="exemple@gmail.com" style="-fx-background-radius: 8;" />
                    </children>
                </VBox>
                <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <children>
                        <Label text="Spécialité *" textFill="#4A4A4A" />
                        <ComboBox fx:id="specialiteCombo" maxWidth="Infinity" promptText="Sélectionner..." style="-fx-background-radius: 8;" />
                    </children>
                </VBox>
                <VBox spacing="5.0" GridPane.rowIndex="2">
                    <children>
                        <Label text="Photo de profil" textFill="#4A4A4A" />
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <children>
                                <Button onAction="#handleChooseImage" text="Choisir une image..." style="-fx-background-radius: 8;" />
                                <Label fx:id="imagePathLabel" text="default_avatar.png" textFill="#9CA3AF" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </GridPane>

        <HBox alignment="CENTER_RIGHT" spacing="15.0">
            <children>
                <Label fx:id="errorLabel" textFill="#EF4444" />
                <Button fx:id="submitButton" onAction="#handleSave" prefHeight="40.0" prefWidth="150.0" style="-fx-background-color: #4F46E5; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;" text="Enregistrer l'Expert">
                    <font><Font name="System Bold" size="14.0" /></font>
                </Button>
            </children>
            <VBox.margin><Insets top="20.0" /></VBox.margin>
        </HBox>
    </children>
</VBox>