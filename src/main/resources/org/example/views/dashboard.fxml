<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane prefHeight="750.0" prefWidth="1200.0" stylesheets="@../styles.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.DashboardController">

    <!-- ===== LEFT: Sidebar ===== -->
    <left>
        <VBox prefWidth="250" styleClass="sidebar" spacing="20">
            <padding>
                <Insets top="30" left="20" right="20" bottom="30"/>
            </padding>
            
            <!-- Logo -->
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="logo-container">
                <Label text="🌱" style="-fx-font-size: 28;"/>
                <Label text="MindGrow" styleClass="logo-text"/>
            </HBox>
            
            <Region prefHeight="20"/>

            <!-- Navigation Menu -->
            <VBox spacing="10">
                <Button fx:id="btnOverview" text="Overview" styleClass="nav-button, nav-active" onAction="#showOverview" maxWidth="Infinity" alignment="CENTER_LEFT">
                    <graphic><SVGPath content="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" scaleX="0.9" scaleY="0.9"/></graphic>
                </Button>
                <Button fx:id="btnPatients" text="Patients" styleClass="nav-button" onAction="#showPatients" maxWidth="Infinity" alignment="CENTER_LEFT">
                    <graphic><SVGPath content="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" scaleX="0.9" scaleY="0.9"/></graphic>
                </Button>
                <Button fx:id="btnDoctors" text="Doctors" styleClass="nav-button" onAction="#showDoctors" maxWidth="Infinity" alignment="CENTER_LEFT">
                    <graphic><SVGPath content="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" scaleX="0.9" scaleY="0.9"/></graphic>
                </Button>
                <Button fx:id="btnAdmins" text="Admins" styleClass="nav-button" onAction="#showAdmins" maxWidth="Infinity" alignment="CENTER_LEFT">
                    <graphic><SVGPath content="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" scaleX="0.9" scaleY="0.9"/></graphic>
                </Button>
            </VBox>
            
            <Region VBox.vgrow="ALWAYS"/>
            
            <!-- Logout -->
            <Button text="Sign Out" styleClass="sidebar-logout" onAction="#handleLogout" maxWidth="Infinity" alignment="CENTER_LEFT">
                <graphic><SVGPath content="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" scaleX="0.9" scaleY="0.9"/></graphic>
            </Button>
        </VBox>
    </left>


    <!-- ===== CENTER: Main Content ===== -->
    <center>
        <VBox spacing="0" styleClass="content-area">
            <!-- Header (Dynamic Title) -->
            <HBox alignment="CENTER_LEFT" styleClass="content-header" spacing="20">
                <Label fx:id="pageTitle" text="Overview" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                
                <!-- Search -->
                <HBox alignment="CENTER_LEFT" styleClass="search-box">
                    <Label text="🔍" style="-fx-text-fill: -text-light;"/>
                    <TextField fx:id="searchField" promptText="Search..." styleClass="search-input"/>
                </HBox>
                
                <!-- Add Button -->
                <Button fx:id="addBtn" text="＋ Add New" styleClass="primary-button" onAction="#handleAddUser"/>
                
                <!-- User Profile (just name) -->
                <HBox alignment="CENTER" spacing="10" styleClass="user-profile-widget">
                    <StackPane styleClass="profile-circle">
                         <Label fx:id="adminInitials" text="A" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                    </StackPane>
                    <Label fx:id="adminNameLabel" text="Admin" style="-fx-font-weight: bold;"/>
                </HBox>
            </HBox>

            <!-- Stats Row (Only visible in Overview) -->
            <HBox fx:id="statsContainer" spacing="20" style="-fx-padding: 30 40 20 40;">
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Label fx:id="totalUsersLabel" text="0" styleClass="stat-number"/>
                    <Label text="Total Users" styleClass="stat-label"/>
                </VBox>
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Label fx:id="activePatientsLabel" text="0" styleClass="stat-number"/>
                    <Label text="Active Patients" styleClass="stat-label"/>
                </VBox>
                 <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Label fx:id="totalDoctorsLabel" text="0" styleClass="stat-number"/>
                    <Label text="Doctors" styleClass="stat-label"/>
                </VBox>
            </HBox>

            <!-- Cards ScrollPane -->
            <ScrollPane fitToWidth="true" styleClass="cards-scroll" VBox.vgrow="ALWAYS">
                <FlowPane fx:id="cardsContainer" styleClass="cards-container"/>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
