<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="650.0" prefWidth="900.0" styleClass="auth-bg"
           stylesheets="@../styles.css"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.example.controllers.ForgotPasswordController">

    <VBox alignment="CENTER" maxWidth="420" spacing="6" styleClass="auth-card">
        <padding>
            <Insets bottom="35" left="40" right="40" top="35"/>
        </padding>

        <!-- Logo -->
        <HBox alignment="CENTER" spacing="8">
            <Label text="🌱" style="-fx-font-size: 30;"/>
            <Label text="MindGrow" styleClass="header-title"
                   style="-fx-font-size: 26; -fx-font-weight: bold;"/>
        </HBox>

        <Label text="Reset Password" styleClass="auth-title"
               style="-fx-padding: 10 0 0 0;"/>
        <Label text="Enter your email to receive a reset code" styleClass="auth-subtitle"/>

        <Label/>

        <!-- Step 1: Email input -->
        <VBox fx:id="step1Pane" spacing="8">
            <Label text="Email Address" style="-fx-text-fill: #636E72; -fx-font-size: 13;"/>
            <TextField fx:id="emailField" promptText="your@email.com" styleClass="text-input"/>
            <Button mnemonicParsing="false" onAction="#handleSendCode"
                    prefWidth="340" text="Send Reset Code" styleClass="primary-button"
                    style="-fx-padding: 14 30;"/>
        </VBox>

        <!-- Step 2: Token + New Password -->
        <VBox fx:id="step2Pane" spacing="8" visible="false" managed="false">
            <Label text="Reset Code" style="-fx-text-fill: #636E72; -fx-font-size: 13;"/>
            <TextField fx:id="tokenField" promptText="Enter 6-digit code" styleClass="text-input"
                       style="-fx-font-size: 18; -fx-alignment: center;"/>

            <Label text="New Password" style="-fx-text-fill: #636E72; -fx-font-size: 13; -fx-padding: 8 0 0 0;"/>
            <PasswordField fx:id="newPasswordField" promptText="••••••••" styleClass="text-input"/>

            <Label text="Confirm Password" style="-fx-text-fill: #636E72; -fx-font-size: 13; -fx-padding: 8 0 0 0;"/>
            <PasswordField fx:id="confirmPasswordField" promptText="••••••••" styleClass="text-input"/>

            <Button mnemonicParsing="false" onAction="#handleResetPassword"
                    prefWidth="340" text="Reset Password" styleClass="accent-button"
                    style="-fx-padding: 14 30;"/>
        </VBox>

        <!-- Status messages -->
        <Label fx:id="statusLabel" styleClass="error-label" wrapText="true"/>

        <!-- Back to login -->
        <Button mnemonicParsing="false" onAction="#goToLogin"
                styleClass="link-button" text="← Back to Login"/>
    </VBox>
</StackPane>
