<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<StackPane prefHeight="650.0" prefWidth="900.0" styleClass="auth-bg"
           stylesheets="@../styles.css"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.example.controllers.LoginController">

    <!-- Centered auth card -->
    <VBox alignment="CENTER" maxWidth="400" spacing="6" styleClass="auth-card">
        <padding>
            <Insets bottom="35" left="40" right="40" top="35"/>
        </padding>

        <!-- Logo -->
        <HBox alignment="CENTER" spacing="8">
            <Label text="🌱" style="-fx-font-size: 30;"/>
            <Label text="MindGrow" styleClass="header-title"
                   style="-fx-font-size: 26; -fx-font-weight: bold;"/>
        </HBox>

        <!-- Title -->
        <Label text="Welcome Back" styleClass="auth-title"
               style="-fx-padding: 10 0 0 0;"/>
        <Label text="Sign in to your admin account" styleClass="auth-subtitle"/>

        <!-- Spacer -->
        <Label/>

        <!-- Email -->
        <Label text="Email" style="-fx-text-fill: #636E72; -fx-font-size: 13;"/>
        <TextField fx:id="emailField" promptText="your@email.com" styleClass="text-input"/>

        <!-- Password -->
        <Label text="Password" style="-fx-text-fill: #636E72; -fx-font-size: 13; -fx-padding: 8 0 0 0;"/>
        <PasswordField fx:id="passwordField" promptText="••••••••" styleClass="text-input"/>

        <!-- Error label -->
        <Label fx:id="errorLabel" styleClass="error-label" wrapText="true"/>

        <!-- Login button -->
        <Button mnemonicParsing="false" onAction="#handleLogin"
                prefWidth="320" text="Sign In" styleClass="primary-button"
                style="-fx-padding: 14 30;"/>

        <!-- Links row -->
        <HBox alignment="CENTER" spacing="20">
            <Button mnemonicParsing="false" onAction="#handleForgotPassword"
                    styleClass="link-button" text="Forgot Password?"/>
            <Button mnemonicParsing="false" onAction="#goToRegister"
                    styleClass="link-button" text="Create Account"/>
        </HBox>
    </VBox>
</StackPane>
