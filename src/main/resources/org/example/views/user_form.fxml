<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20" styleClass="dialog-pane" stylesheets="@../styles.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.UserFormController">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" styleClass="header-panel">
        <Label fx:id="headerLabel" text="Add New User" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: -primary;"/>
    </HBox>

    <!-- Content -->
    <VBox spacing="15" styleClass="content">
        <HBox spacing="15">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Last Name" style="-fx-text-fill: -text-mid;"/>
                <TextField fx:id="nomField" promptText="Enter last name" styleClass="text-input"/>
            </VBox>
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="First Name" style="-fx-text-fill: -text-mid;"/>
                <TextField fx:id="prenomField" promptText="Enter first name" styleClass="text-input"/>
            </VBox>
        </HBox>

        <VBox spacing="5">
            <Label text="Email Address" style="-fx-text-fill: -text-mid;"/>
            <TextField fx:id="emailField" promptText="Enter email address" styleClass="text-input"/>
        </VBox>

        <HBox spacing="15">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Phone Number" style="-fx-text-fill: -text-mid;"/>
                <TextField fx:id="phoneField" promptText="Enter phone number" styleClass="text-input"/>
            </VBox>
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Birth Date" style="-fx-text-fill: -text-mid;"/>
                <TextField fx:id="dobField" promptText="DD/MM/YYYY" styleClass="text-input"/>
            </VBox>
        </HBox>

        <HBox spacing="15">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Role" style="-fx-text-fill: -text-mid;"/>
                <ComboBox fx:id="roleCombo" promptText="Select Role" styleClass="filter-combo" maxWidth="Infinity"/>
            </VBox>
        </HBox>

        <VBox spacing="5" fx:id="passwordContainer">
            <Label text="Password" style="-fx-text-fill: -text-mid;"/>
            <PasswordField fx:id="passwordField" promptText="Enter password" styleClass="text-input"/>
            <Label fx:id="passwordHint" text="Leave blank to keep existing password" 
                   style="-fx-font-size: 11; -fx-text-fill: -text-light;" visible="false" managed="false"/>
        </VBox>
        
        <Label fx:id="errorLabel" styleClass="error-label" wrapText="true"/>
    </VBox>

    <!-- Footer -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="cancelButton" text="Cancel" onAction="#handleCancel" 
                style="-fx-background-color: transparent; -fx-text-fill: -text-mid; -fx-cursor: hand;"/>
        <Button text="Save User" onAction="#handleSave" styleClass="primary-button"/>
    </HBox>

</VBox>
