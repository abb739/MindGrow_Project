<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="mainLayout" prefHeight="768.0" prefWidth="1024.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.TherapistDashboardController">
   <left>
      <VBox alignment="TOP_CENTER" prefHeight="768.0" prefWidth="250.0" spacing="20.0" style="-fx-background-color: #A2D5AB;" BorderPane.alignment="CENTER">
         <children>
            <Label text="MindGrow" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="28.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="20.0" top="30.0" />
               </VBox.margin>
            </Label>
            <Label fx:id="welcomeLabel" text="Welcome, Therapist" textFill="WHITE">
               <font>
                  <Font size="16.0" />
               </font>
            </Label>
            <Button mnemonicParsing="false" onAction="#loadProgramsView" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;" text="Programs" />

            <Button mnemonicParsing="false" onAction="#handleLogout" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: #ff6b6b; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;" text="Logout">
               <VBox.margin>
                  <Insets top="400.0" />
               </VBox.margin>
            </Button>
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </VBox>
   </left>
</BorderPane>
