<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="768.0" prefWidth="774.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.ExerciseDetailsController" stylesheets="@../styles.css">
   <children>
      <VBox prefHeight="768.0" prefWidth="774.0" spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
         </padding>
         <children>
            <Button mnemonicParsing="false" onAction="#handleBack" styleClass="primary-button" text="&lt; Back to Programs" />
            
            <Label fx:id="titleLabel" text="Exercise Title" textFill="#444444">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
            
            <VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #f9f9f9; -fx-background-radius: 10; -fx-padding: 40;">
               <children>
                  <Label text="Duration Timer" textFill="#888888">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
                  <Label fx:id="timerLabel" text="00:00" textFill="#A2D5AB">
                     <font>
                        <Font name="System Bold" size="72.0" />
                     </font>
                  </Label>
                  <ProgressBar fx:id="progressBar" prefWidth="400.0" progress="0.0" />
                  
                  <HBox alignment="CENTER" spacing="20.0">
                     <children>
                        <Button fx:id="playPauseBtn" mnemonicParsing="false" onAction="#handlePlayPause" prefHeight="40.0" prefWidth="150.0" style="-fx-font-size: 16px;" styleClass="primary-button" text="▶ Start Exercise" />
                        <Button mnemonicParsing="false" onAction="#handleReset" prefHeight="40.0" prefWidth="100.0" style="-fx-font-size: 16px; -fx-background-color: #ddd; -fx-text-fill: #555;" styleClass="primary-button" text="Reset" />
                     </children>
                  </HBox>
               </children>
            </VBox>
            
            <Label text="Instructions" textFill="#444444">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font>
            </Label>
            
            <Label fx:id="descriptionLabel" text="Exercise instructions go here..." textFill="#666666" wrapText="true">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
         </children>
      </VBox>
   </children>
</AnchorPane>
