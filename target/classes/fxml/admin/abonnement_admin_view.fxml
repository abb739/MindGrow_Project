<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.admin.AbonnementAdminController"
            prefWidth="1500" prefHeight="900"
            style="-fx-background-color: #F5F5F5;">

    <!-- En-tête ADMIN -->
    <top>
        <VBox style="-fx-background-color: linear-gradient(to right, #7CAA85, #A2D5AB); -fx-padding: 25;">
            <HBox alignment="CENTER_LEFT" spacing="15">
                <!-- Logo -->
                <VBox alignment="CENTER" style="-fx-background-color: white; -fx-background-radius: 50; -fx-padding: 15; -fx-pref-width: 60; -fx-pref-height: 60;">
                    <Label text="🌱" style="-fx-font-size: 30;"/>
                </VBox>

                <!-- Badge ADMIN -->
                <VBox alignment="CENTER" style="-fx-background-color: #e74c3c; -fx-background-radius: 8; -fx-padding: 8 15;">
                    <Label text="ADMIN" textFill="WHITE" style="-fx-font-size: 12; -fx-font-weight: bold;"/>
                </VBox>

                <!-- Titre -->
                <VBox VBox.vgrow="ALWAYS">
                    <Label text="ADMIN - Gestion des Abonnements" textFill="WHITE">
                        <font><Font name="System Bold" size="28.0"/></font>
                    </Label>
                    <Label text="Tableau de bord administrateur MindGrow" textFill="WHITE" style="-fx-padding: 5 0 0 0; -fx-opacity: 0.9;">
                        <font><Font size="14.0"/></font>
                    </Label>
                </VBox>
            </HBox>
        </VBox>
    </top>

    <!-- Contenu principal -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox spacing="20" style="-fx-padding: 25;">

                <!-- SECTION 1 : Statistiques en cartes -->
                <HBox spacing="20" alignment="CENTER">
                    <!-- Carte Total -->
                    <VBox spacing="10" alignment="CENTER" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-pref-width: 240; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                        <Label text="📊 TOTAL" style="-fx-font-size: 12; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
                        <Label fx:id="totalLabel" text="0" style="-fx-font-size: 38; -fx-text-fill: #7CAA85; -fx-font-weight: bold;"/>
                        <Label text="Abonnements" style="-fx-font-size: 11; -fx-text-fill: #95a5a6;"/>
                    </VBox>

                    <!-- Carte Actifs -->
                    <VBox spacing="10" alignment="CENTER" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-pref-width: 240; -fx-effect: dropshadow(gaussian, rgba(39, 174, 96, 0.2), 12, 0, 0, 3);">
                        <Label text="✅ ACTIFS" style="-fx-font-size: 12; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
                        <Label fx:id="actifsLabel" text="0" style="-fx-font-size: 38; -fx-text-fill: #27ae60; -fx-font-weight: bold;"/>
                        <Label text="En cours" style="-fx-font-size: 11; -fx-text-fill: #95a5a6;"/>
                    </VBox>

                    <!-- Carte Revenu -->
                    <VBox spacing="10" alignment="CENTER" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-pref-width: 240; -fx-effect: dropshadow(gaussian, rgba(243, 156, 18, 0.2), 12, 0, 0, 3);">
                        <Label text="💰 REVENU" style="-fx-font-size: 12; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
                        <Label fx:id="revenuLabel" text="0.00 €" style="-fx-font-size: 38; -fx-text-fill: #f39c12; -fx-font-weight: bold;"/>
                        <Label text="Total généré" style="-fx-font-size: 11; -fx-text-fill: #95a5a6;"/>
                    </VBox>

                    <!-- Carte Taux actifs -->
                    <VBox spacing="10" alignment="CENTER" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-pref-width: 240; -fx-effect: dropshadow(gaussian, rgba(52, 152, 219, 0.2), 12, 0, 0, 3);">
                        <Label text="📈 TAUX ACTIFS" style="-fx-font-size: 12; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
                        <Label fx:id="tauxConversionLabel" text="0%" style="-fx-font-size: 38; -fx-text-fill: #3498db; -fx-font-weight: bold;"/>
                        <Label text="Actifs / Total" style="-fx-font-size: 11; -fx-text-fill: #95a5a6;"/>
                    </VBox>
                </HBox>

                <!-- SECTION 2 : Recherche et Filtres -->
                <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2);">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="🔍 Recherche et Filtres" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #4A4A4A;"/>
                    </HBox>

                    <Separator style="-fx-background-color: #E8E8E8;"/>

                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <!-- Recherche -->
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Rechercher" style="-fx-font-size: 12; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
                            <TextField fx:id="rechercheField" promptText="Nom, prénom ou email..."
                                       prefHeight="40"
                                       style="-fx-padding: 10; -fx-border-color: #A2D5AB; -fx-border-width: 2; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 14;"/>
                        </VBox>

                        <!-- Filtre Type -->
                        <VBox spacing="5">
                            <Label text="Type" style="-fx-font-size: 12; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
                            <ComboBox fx:id="filtreTypeCombo" promptText="Tous" prefWidth="150" prefHeight="40"
                                      style="-fx-font-size: 14;"/>
                        </VBox>

                        <!-- Filtre Statut -->
                        <VBox spacing="5">
                            <Label text="Statut" style="-fx-font-size: 12; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
                            <ComboBox fx:id="filtreStatutCombo" promptText="Tous" prefWidth="140" prefHeight="40"
                                      style="-fx-font-size: 14;"/>
                        </VBox>

                        <!-- Boutons de recherche -->
                        <VBox spacing="5" alignment="BOTTOM_LEFT">
                            <HBox spacing="10">
                                <Button text="🔍 Rechercher" onAction="#rechercherAbonnements"
                                        prefHeight="40"
                                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8;"/>
                                <Button text="↺ Réinitialiser" onAction="#reinitialiserFiltres"
                                        prefHeight="40"
                                        style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8;"/>
                            </HBox>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- SECTION 3 : Formulaire d'ajout/modification -->
                <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2);">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="📝 Formulaire Abonnement" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #4A4A4A;"/>
                    </HBox>

                    <Separator style="-fx-background-color: #E8E8E8;"/>

                    <GridPane hgap="20" vgap="15">
                        <columnConstraints>
                            <ColumnConstraints minWidth="120"/>
                            <ColumnConstraints prefWidth="220" hgrow="SOMETIMES"/>
                            <ColumnConstraints minWidth="120"/>
                            <ColumnConstraints prefWidth="220" hgrow="SOMETIMES"/>
                        </columnConstraints>

                        <Label text="Utilisateur *" GridPane.columnIndex="0" GridPane.rowIndex="0"
                               style="-fx-font-weight: bold; -fx-text-fill: #4A4A4A; -fx-font-size: 13;"/>
                        <ComboBox fx:id="utilisateurCombo" promptText="Sélectionner un utilisateur" GridPane.columnIndex="1" GridPane.rowIndex="0"
                                  prefWidth="220" prefHeight="40"
                                  style="-fx-font-size: 14;"/>

                        <Label text="Type *" GridPane.columnIndex="2" GridPane.rowIndex="0"
                               style="-fx-font-weight: bold; -fx-text-fill: #4A4A4A; -fx-font-size: 13;"/>
                        <ComboBox fx:id="typeCombo" promptText="Sélectionner" GridPane.columnIndex="3" GridPane.rowIndex="0"
                                  prefWidth="220" prefHeight="40"
                                  style="-fx-font-size: 14;"/>

                        <Label text="Montant (€) *" GridPane.columnIndex="0" GridPane.rowIndex="1"
                               style="-fx-font-weight: bold; -fx-text-fill: #4A4A4A; -fx-font-size: 13;"/>
                        <TextField fx:id="montantField" promptText="Ex: 29.99" GridPane.columnIndex="1" GridPane.rowIndex="1"
                                   prefHeight="40"
                                   style="-fx-padding: 10; -fx-border-color: #A2D5AB; -fx-border-width: 2; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 14;"/>

                        <Label text="Statut *" GridPane.columnIndex="2" GridPane.rowIndex="1"
                               style="-fx-font-weight: bold; -fx-text-fill: #4A4A4A; -fx-font-size: 13;"/>
                        <ComboBox fx:id="statutCombo" promptText="Sélectionner" GridPane.columnIndex="3" GridPane.rowIndex="1"
                                  prefWidth="220" prefHeight="40"
                                  style="-fx-font-size: 14;"/>

                        <Label text="Date début *" GridPane.columnIndex="0" GridPane.rowIndex="2"
                               style="-fx-font-weight: bold; -fx-text-fill: #4A4A4A; -fx-font-size: 13;"/>
                        <DatePicker fx:id="dateDebutPicker" GridPane.columnIndex="1" GridPane.rowIndex="2"
                                    prefWidth="220" prefHeight="40"
                                    style="-fx-font-size: 14;"/>

                        <Label text="Date expiration" GridPane.columnIndex="2" GridPane.rowIndex="2"
                               style="-fx-font-weight: bold; -fx-text-fill: #95a5a6; -fx-font-size: 13;"/>
                        <HBox GridPane.columnIndex="3" GridPane.rowIndex="2" alignment="CENTER_LEFT" spacing="8"
                              style="-fx-background-color: #F0F0F0; -fx-padding: 10; -fx-border-radius: 8; -fx-background-radius: 8; -fx-pref-height: 40;">
                            <Label text="⚡ Calculée automatiquement" style="-fx-font-size: 12; -fx-text-fill: #666; -fx-font-style: italic;"/>
                        </HBox>
                    </GridPane>

                    <!-- Légende -->
                    <HBox spacing="20" alignment="CENTER" style="-fx-padding: 10 0;">
                        <Label text="📅 Durées:" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #7f8c8d;"/>
                        <Label text="MENSUEL = +1 mois" style="-fx-font-size: 12; -fx-text-fill: #27ae60; -fx-font-weight: bold;"/>
                        <Label text="TRIMESTRIEL = +3 mois" style="-fx-font-size: 12; -fx-text-fill: #f39c12; -fx-font-weight: bold;"/>
                        <Label text="ANNUEL = +1 an" style="-fx-font-size: 12; -fx-text-fill: #3498db; -fx-font-weight: bold;"/>
                    </HBox>

                    <!-- BOUTONS D'ACTION PRINCIPAUX -->
                    <VBox spacing="15" alignment="CENTER" style="-fx-padding: 20 0;">
                        <!-- Ligne 1 : Créer, Modifier, Supprimer, Vider -->
                        <HBox spacing="15" alignment="CENTER">
                            <Button text="➕ CRÉER" onAction="#ajouter"
                                    prefWidth="180" prefHeight="50"
                                    style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 10;"/>
                            <Button text="✏️ MODIFIER" onAction="#modifier"
                                    prefWidth="180" prefHeight="50"
                                    style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 10;"/>
                            <Button text="🗑️ SUPPRIMER" onAction="#supprimer"
                                    prefWidth="180" prefHeight="50"
                                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 10;"/>
                            <Button text="🧹 VIDER" onAction="#vider"
                                    prefWidth="180" prefHeight="50"
                                    style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 10;"/>
                        </HBox>

                        <!-- Ligne 2 : Suspendre, Activer, Prolonger -->
                        <HBox spacing="15" alignment="CENTER">
                            <Button text="⏸️ SUSPENDRE" onAction="#suspendreAbonnement"
                                    prefWidth="180" prefHeight="50"
                                    style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 10;"/>
                            <Button text="✅ ACTIVER" onAction="#activerAbonnement"
                                    prefWidth="180" prefHeight="50"
                                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 10;"/>
                            <Button text="⏰ PROLONGER" onAction="#prolongerAbonnement"
                                    prefWidth="180" prefHeight="50"
                                    style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 10;"/>
                        </HBox>
                    </VBox>
                </VBox>

                <!-- SECTION 4 : TableView AVEC LA NOUVELLE COLONNE STATUT PAIEMENT -->
                <VBox VBox.vgrow="ALWAYS" spacing="15" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2);">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="📋 Liste des abonnements" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #4A4A4A;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="🔄 ACTUALISER" onAction="#rafraichir"
                                prefHeight="40"
                                style="-fx-background-color: #7CAA85; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 25; -fx-background-radius: 8;"/>
                        <Button text="📊 EXPORT EXCEL" onAction="#exporterExcel"
                                prefHeight="40"
                                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 25; -fx-background-radius: 8;"/>
                    </HBox>

                    <Separator style="-fx-background-color: #E8E8E8;"/>

                    <TableView fx:id="tableView" VBox.vgrow="ALWAYS"
                               prefHeight="400"
                               style="-fx-border-color: #E8E8E8; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8;">
                        <columns>
                            <TableColumn fx:id="colId" text="ID" prefWidth="50" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="colUtilisateur" text="Utilisateur" prefWidth="140"/>
                            <TableColumn fx:id="colEmail" text="Email" prefWidth="170"/>
                            <TableColumn fx:id="colType" text="Type" prefWidth="100" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="colMontant" text="Montant" prefWidth="90" style="-fx-alignment: CENTER-RIGHT;"/>
                            <TableColumn fx:id="colDateDebut" text="Début" prefWidth="130" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="colDateExpiration" text="Expiration" prefWidth="130" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="colStatut" text="Statut" prefWidth="100" style="-fx-alignment: CENTER;"/>
                            <!-- NOUVELLE COLONNE : Statut Paiement -->
                            <TableColumn fx:id="colStatutPaiement" text="💳 Paiement" prefWidth="120" style="-fx-alignment: CENTER;"/>
                        </columns>
                    </TableView>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
